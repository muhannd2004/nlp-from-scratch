   "source": "## 2.3: Confusion Matrix & Evaluation Metrics",
   "id": "eval_metrics_header"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "#### From-Scratch Implementation",
   "id": "scratch_impl_header"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-10-19T22:43:28.287356985Z",
     "start_time": "2026-10-19T22:43:28.224742219Z"
    }
   },
   "source": [
    "def confusion_matrix_scratch(y_true, y_pred, n_classes=None):\n",
    "    y_true = np.array(y_true)\n",
    "    y_pred = np.array(y_pred)\n",
    "    if n_classes is None:\n",
    "        n_classes = max(y_true.max(), y_pred.max()) + 1\n",
    "    cm = np.zeros((n_classes, n_classes), dtype=int)\n",
    "    for t, p in zip(y_true, y_pred):\n",
    "        cm[t, p] += 1\n",
    "    return cm"
   ],
   "id": "confusion_matrix_fn",
   "outputs": [],
   "execution_count": 87
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-10-19T22:43:29.124280060Z",
     "start_time": "2026-10-19T22:43:29.084086253Z"
    }
   },
   "source": [
    "def precision_recall_f1_scratch(cm):\n",
    "    n_classes = cm.shape[0]\n",
    "    precision = np.zeros(n_classes)\n",
    "    recall = np.zeros(n_classes)\n",
    "    f1 = np.zeros(n_classes)\n",
    "\n",
    "    for c in range(n_classes):\n",
    "        tp = cm[c, c]\n",
    "        fp = cm[:, c].sum() - tp\n",
    "        fn = cm[c, :].sum() - tp\n",
    "\n",
    "        precision[c] = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n",
    "        recall[c]    = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n",
    "        f1[c] = 2 * precision[c] * recall[c] / (precision[c] + recall[c]) if (precision[c] + recall[c]) > 0 else 0.0\n",
    "\n",
    "    macro_precision = precision.mean()\n",
    "    macro_recall    = recall.mean()\n",
    "    macro_f1        = f1.mean()\n",
    "\n",
    "    return precision, recall, f1, macro_precision, macro_recall, macro_f1"
   ],
   "id": "prf1_fn",
   "outputs": [],
   "execution_count": 88
  },
