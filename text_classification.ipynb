    "class LogisticRegressionScratch:\n",
    "    def __init__(self, learning_rate=0.1, epochs=20, batch_size=64):\n",
    "        self.lr = learning_rate\n",
    "        self.epochs = epochs\n",
    "        self.batch_size = batch_size\n",
    "        self.W = None\n",
    "        self.b = None\n",
    "        self.loss_history = []\n",
    "\n",
    "    def fit(self, X, y):\n",
    "        n_samples, n_features = X.shape\n",
    "        n_classes = y.shape[1]\n",
    "\n",
    "        self.W = np.zeros((n_features, n_classes), dtype=np.float64)\n",
    "        self.b = np.zeros((1, n_classes), dtype=np.float64)\n",
    "\n",
    "        for epoche in range(self.epochs):\n",
    "            indices = np.random.permutation(n_samples)\n",
    "            X_shuffled = X[indices]\n",
    "            y_shuffled = y[indices]\n",
    "\n",
    "            epoch_loss = 0.0\n",
    "            num_batches = 0\n",
    "\n",
    "            for start_batch in range(0, n_samples, self.batch_size):\n",
    "                end_batch = min(start_batch + self.batch_size, n_samples)\n",
    "                X_batch = X_shuffled[start_batch:end_batch]\n",
    "                y_batch = y_shuffled[start_batch:end_batch]\n",
    "\n",
    "                z_batch = X_batch.dot(self.W) + self.b\n",
    "\n",
    "                z_exp = np.exp(z_batch - np.max(z_batch, axis=1, keepdims=True))\n",
    "                p = z_exp / np.sum(z_exp, axis=1, keepdims=True)\n",
    "\n",
    "                m = len(y_batch)\n",
    "                loss = (-1.0 / m) * np.sum(np.log(p + 1e-15) * y_batch)\n",
    "                epoch_loss += loss\n",
    "                num_batches += 1\n",
    "\n",
    "                dZ = (p - y_batch) / m\n",
    "                dW = X_batch.T.dot(dZ)\n",
    "                db = np.sum(dZ, axis=0, keepdims=True)\n",
    "\n",
    "                self.W -= self.lr * dW\n",
    "                self.b -= self.lr * db\n",
    "\n",
    "            avg_loss = epoch_loss / num_batches\n",
    "            self.loss_history.append(avg_loss)\n",
    "            print(f\"Epoch {epoche + 1}/{self.epochs} - Loss: {avg_loss:.4f}\")\n",
    "\n",
    "    def predict_score(self, X):\n",
    "        z = X.dot(self.W) + self.b\n",
    "        z_exp = np.exp(z - np.max(z, axis=1, keepdims=True))\n",
    "        p = z_exp / np.sum(z_exp, axis=1, keepdims=True)\n",
    "        return p\n",
    "\n",
    "    def predict(self, X):\n",
    "        z = X.dot(self.W) + self.b\n",
    "        return np.argmax(z, axis=1)\n"
   ],
