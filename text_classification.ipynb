   },
   "outputs": [],
   "source": [
    "def to_bi_grams(x):\n",
    "    vocab = {}\n",
    "    for tokens in x:\n",
    "        for bg in list(bigrams(tokens)):\n",
    "            if bg not in vocab:\n",
    "                vocab[bg] = len(vocab)\n",
    "\n",
    "    return vocab"
   ],
   "id": "2546eb6723fb89a",
   "outputs": [],
   "execution_count": 10
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "393009ffb3f5800",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-10-19T18:17:01.053958273Z",
     "start_time": "2026-10-19T18:17:01.000834631Z"
    }
   },
   "outputs": [],
   "source": [
    "def construct_sparse_binary_vector(vocab, x):\n",
    "    rows = []\n",
    "    cols = []\n",
    "\n",
    "    for row_idx, tokens in enumerate(x):\n",
    "        for bg in set(bigrams(tokens)):\n",
    "            col_idx = vocab.get(bg)\n",
    "            if col_idx is not None:\n",
    "                rows.append(row_idx)\n",
    "                cols.append(col_idx)\n",
    "\n",
    "    data = np.ones(len(rows), dtype=np.int8)\n",
    "\n",
    "    return csr_matrix((data, (rows, cols)), shape=(len(x), len(vocab)), dtype=np.int8)"
   ],
   "id": "393009ffb3f5800",
   "outputs": [],
   "execution_count": 11
   ]
  },
