    "def process_and_tokenize(x):\n",
    "    arr_tokens = [word_tokenize(sentence.lower()) for sentence in x]\n",
    "    for i, tokens in enumerate(arr_tokens):\n",
    "       arr_tokens[i] = [token for token in tokens if token.isalpha()]\n",
    "\n",
    "    return arr_tokens"
   ],
   "id": "7df2e689eade8b9c",
   "outputs": [],
   "execution_count": 6
   ]
  },
