    }
   },
   "outputs": [],
   "source": [
    "def smart_lemmatize(word):\n",
    "    verb_synsets = wordnet.synsets(word, pos='v')\n",
    "    if verb_synsets:\n",
    "        return lemmatizer.lemmatize(word, pos='v')\n",
    "    return lemmatizer.lemmatize(word, pos='n')\n",
    "\n",
    "def lemmatization(x):\n",
    "    return [[smart_lemmatize(token) for token in tokens] for tokens in x]"
   ],
   "id": "56ce7455261abaaa",
   "outputs": [],
   "execution_count": 7
   ]
  },
